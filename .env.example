PORT=8000
HOST=0.0.0.0

# Cấu hình Facebook Fanpage Messenger
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FB_VERIFY_TOKEN=fitman_webhook_verify_2026

# 1. Chatbot phục vụ khách hàng (OpenAI GPT-4o-mini)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
USE_LOCAL_LLM=false

# 2. AI Coder Local (Qwen 3 Coder tại port 5001 viết code theo chỉ đạo của Kỹ sư trưởng Antigravity)
QWEN_API_BASE=http://127.0.0.1:5001/v1
QWEN_FALLBACK_PORT=5001

# URL công khai của Server (khi deploy Render hoặc dùng ngrok để Facebook gửi ảnh)
SERVER_BASE_URL=https://your-app-name.onrender.com
