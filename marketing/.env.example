# Token bot Telegram lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Kết nối trực tiếp qua Antigravity (Mặc định: true, không cần API Key, không bị lỗi 503)
USE_ANTIGRAVITY_CLI=true
AGY_MODEL=gemini-3.8-flash-high

# Tùy chọn: API Key Google Gemini (chỉ dùng khi tắt USE_ANTIGRAVITY_CLI)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# Địa chỉ ComfyUI (Mặc định local chạy cổng 8188)
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
